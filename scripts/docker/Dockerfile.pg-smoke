# Test-only derivative. Never published as a service image or used for real DBs.
ARG SERVICE_IMAGE=requi-control-plane-check
FROM ${SERVICE_IMAGE}
USER root
# Debian provides native amd64 AND arm64 PostgreSQL. pgserver's Linux wheels
# are x86_64-only, so installing it would break Apple Silicon image smoke.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/postgresql/*/bin /opt/smoke-pg-bin
ENV REQUI_SMOKE_PG_BIN=/opt/smoke-pg-bin
COPY src/delivery_api/runtime_roles.py /smoke/src/delivery_api/
COPY tests/pg_harness.py tests/pg_guardian.py /smoke/tests/
COPY supabase/migrations/ /smoke/supabase/migrations/
COPY scripts/docker/owned-pg-smoke.py scripts/docker/system-pg-smoke.py /smoke/
USER 10001:10001
CMD ["python", "/smoke/owned-pg-smoke.py", "/smoke", "python", "-m", "delivery_api.control_plane"]
