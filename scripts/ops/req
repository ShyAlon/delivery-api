#!/usr/bin/env bash
# req: run the newest Requi.re script from ~/Downloads. No arguments needed. Expired scripts are archived by their expires= stamp; there is no age prompt.
#   req            run the newest verified script (kept in place if it fails, so you can run req again)
#   req list       show pending scripts
#   req download NAME  explicitly run the newest downloaded script with that name
#   req status     read-only: git status of every repo under ~/development/require
#   req clean      keep the newest pending script, archive the other pending ones to requi-done/stale
set -uo pipefail
case "${1:-}" in
migrate|policy|preflight|force-stop|stop-all|preview-free|reset-preview)
  REPO="${REQUI_ROOT:-$HOME/development/require}/delivery-api"
  fail(){ echo "REQ ABORTED: $* No owner step was run." >&2; exit 1; }
  [ -d "$REPO/.git" ] || fail "delivery-api checkout missing at $REPO."
  [ "$(git -C "$REPO" branch --show-current)" = main ] || fail "switch the checkout to main first."
  [ -z "$(git -C "$REPO" status --porcelain --untracked-files=no)" ] || fail "tracked checkout changes; commit/stash them first."
  git -C "$REPO" fetch origin main || fail "fetch failed; check Git access."
  git -C "$REPO" merge --ff-only origin/main || fail "main cannot fast-forward; inspect local commits."
  [ "$(git -C "$REPO" rev-parse HEAD)" = "$(git -C "$REPO" rev-parse origin/main)" ] || fail "checkout is not current main."
  [ -f "$REPO/scripts/ops/req-owner.sh" ] || fail "pull main containing the req owner commands."
  exec bash "$REPO/scripts/ops/req-owner.sh" "$@";;
help|--help|-h)
  echo 'req migrate | policy | preflight | force-stop | stop-all | preview-free | reset-preview'
  echo 'Owner commands sync clean main and default to dry review. --apply is explicit; existing confirmations stay.'
  echo 'req preflight --email your-signed-up-email; req list/status/clean; downloaded scripts require req download NAME.';exit 0;;
esac
DL=${REQ_DOWNLOADS:-$HOME/Downloads}; DONE=$DL/requi-done
mt(){ if [ "$(uname)" = Darwin ]; then stat -f %m "$1"; else stat -c %Y "$1"; fi; }
superseded(){ # $1 name $2 mtime of candidate: a same-name script already ran that was downloaded later => candidate is old
  for d in "$DONE/$1"-*.txt; do [ -f "$d" ] || continue
    r=${d##*/}; r=${r#"$1"-}; [[ "$r" =~ ^[0-9a-f]{8}-[0-9]{6}\.txt$ ]] || continue
    [ "$(mt "$d")" -ge "$2" ] && { echo "$d"; return 0; }
  done; return 1; }
sha8(){ grep -v '^# REQUI-SCRIPT ' "$1" | shasum -a 256 | cut -c1-8; }
cands(){ # prints: mtime<TAB>file<TAB>name<TAB>sha8-in-marker
  for f in "$DL"/*.txt; do [ -f "$f" ] || continue
    m=$(sed -n '1,6p' "$f" | grep -m1 '^# REQUI-SCRIPT ') || continue
    set -- $m; e=""; for w in "$@"; do case "$w" in expires=*) e=${w#expires=};; esac; done
    printf '%s\t%s\t%s\t%s\t%s\n' "$(if [ "$(uname)" = Darwin ]; then stat -f %m "$f"; else stat -c %Y "$f"; fi)" "$f" "$3" "$4" "$e"
  done | sort -rn; }
case "${1:-}" in
status)
  R=${REQUI_ROOT:-$HOME/development/require}
  for d in "$R"/*/; do [ -d "$d/.git" ] || continue
    echo "== $(basename "$d")  branch $(git -C "$d" rev-parse --abbrev-ref HEAD)"
    git -C "$d" status --short | head -15
    git -C "$d" status --short | grep '^??' | sed 's/^?? //' | head -5 | while read -r p; do echo "   untracked and not ignored: $p   (fix: echo '$p' >> $d/.gitignore, or delete it)"; done
    git -C "$d" status --short | grep -v '^??' | head -3 | while read -r l; do echo "   tracked change: $l   (see: git -C $d diff --stat)"; done
  done; exit 0;;
clean) K=0; while IFS=$'\t' read -r t f n s e; do
    if [ "$K" = 0 ]; then K=1; echo "kept (newest): $n $s"; continue; fi
    mkdir -p "$DONE/stale"; mv "$f" "$DONE/stale/$n-$s.txt"; echo "archived stale: $n $s"
  done < <(cands); [ "$K" = 1 ] || echo "no pending Requi.re script"; exit 0;;
list) cands | while IFS=$'\t' read -r t f n s e; do echo "$n $s  $(basename "$f")  ${e:+expires $e}"; done; exit 0;;
esac
case "${1:-}" in
 "") WANT="";;
 download) shift; WANT=${1:-}; [ "$#" = 1 ] && [ -n "$WANT" ] || { echo 'REQ ABORTED: use req download NAME for a Downloads script.' >&2; exit 1; };;
 *) echo 'REQ ABORTED: unknown command. Owner commands never fall back to Downloads. Use req help, or req download NAME explicitly.' >&2; exit 1;;
esac
PICK=""
NOW=$(date +%s)
while IFS=$'\t' read -r t f n s e; do
  [ -z "$WANT" ] || [ "$n" = "$WANT" ] || continue
  if [ -n "$e" ]; then
    X=$(python3 -c 'import sys,calendar,time;print(calendar.timegm(time.strptime(sys.argv[1],"%Y-%m-%dT%H:%M:%SZ")))' "$e" 2>/dev/null || echo 0)
    if [ "$X" -gt 0 ] && [ "$NOW" -gt "$X" ]; then
      mkdir -p "$DONE/expired"; mv "$f" "$DONE/expired/$n-$s.txt"
      echo "(expired and archived: $n $s, it was valid until $e. Download the latest from the chat.)"; continue
    fi
  fi
  if D2=$(superseded "$n" "$t"); then
    mkdir -p "$DONE/superseded"; mv "$f" "$DONE/superseded/$n-$s.txt"
    echo "(old copy archived, not run: $n $s. A newer script with the same name already ran: $(basename "$D2"). Download the latest from the chat if you need it again.)"; continue
  fi
  if [ -z "$PICK" ]; then PICK="$f|$n|$s|$t"; else echo "(older pending, skipped: $n $s)"; fi
done < <(cands)
[ -n "$PICK" ] || { echo "No Requi.re script found in $DL (looked for *.txt with a '# REQUI-SCRIPT' line)."; echo "Fix: download the attachment again, then run: req"; exit 1; }
IFS='|' read -r F N S T <<<"$PICK"
A=$(sha8 "$F")
[ "$A" = "$S" ] || { echo "ABORTED: $(basename "$F") is damaged or edited (content hash $A, expected $S). Nothing was run."; echo "Fix: download the attachment again, then run: req"; exit 1; }
echo "Running $N $S ($(basename "$F"))"
bash "$F"; RC=$?
if [ $RC -eq 0 ]; then mkdir -p "$DONE"; mv "$F" "$DONE/$N-$S-$(date +%H%M%S).txt"; echo "(script moved to $DONE so req cannot re-run it)"
else echo "(exit $RC: script left in Downloads; fix what it said, then run: req)"; fi
exit $RC


[exit code: 0]
