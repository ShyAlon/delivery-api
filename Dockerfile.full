# syntax=docker/dockerfile:1
# Full Requi.re service (interview engine + delivery API) for the private OVH server.
# Build context is the folder made by scripts/docker/build-full-image.sh (one git archive per repo):
#   delivery-api/  interview-engine/  spec-generator/  verification-loop/
# Build:  docker build -f delivery-api/Dockerfile.full -t requi-full:<tag> <context>
FROM python:3.12-slim AS build
WORKDIR /src
COPY delivery-api/ delivery-api/
COPY interview-engine/ interview-engine/
COPY spec-generator/ spec-generator/
COPY verification-loop/ verification-loop/
RUN --mount=type=cache,target=/root/.cache/pip echo "ebebe112cf59418239a831d122c6e4634d6f4ad79e01f4255b72e3cb73673942  delivery-api/vendor/vmodel_contracts-0.29.0-py3-none-any.whl" | sha256sum --check - \
    && echo "ab670b145804e5571cf98e784a49115ae86993ae3e56a91b4e967f5f9b75efb9  delivery-api/vendor/requi_child_contract-0.3.0-py3-none-any.whl" | sha256sum --check - \
    && cmp delivery-api/vendor/requi_child_contract-0.3.0-py3-none-any.whl interview-engine/vendor/requi_child_contract-0.3.0-py3-none-any.whl \
    && pip wheel --no-deps --wheel-dir /wheels ./delivery-api ./interview-engine ./spec-generator ./verification-loop \
    && cp delivery-api/vendor/vmodel_contracts-0.29.0-py3-none-any.whl delivery-api/vendor/requi_child_contract-0.3.0-py3-none-any.whl /wheels/ \
    && python delivery-api/scripts/docker/wheel_deps.py /wheels > /wheels/requirements.txt

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    DELIVERY_HOST=0.0.0.0 DELIVERY_PORT=8000 \
    INTERVIEW_ENGINE_PYTHON=/usr/local/bin/python INTERVIEW_ENGINE_TENANTS=1 \
    VMODEL_ARTIFACTS_DIR=/data/artifacts XDG_DATA_HOME=/data HOME=/data \
    REQUI_STARTUP_EVIDENCE=/data/requi-startup.json
WORKDIR /app
COPY --from=build /wheels/requirements.txt /wheels/requirements.txt
# Internal packages share the exact vendored contracts wheel. Resolve third-party requirements
# from their metadata, then install internal wheels without fetching private git dependencies.
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /wheels/requirements.txt 'psycopg[binary]>=3.2,<4' fastapi uvicorn pydantic httpx python-multipart \
      langgraph langchain-core langchain-openai langchain-ollama python-dotenv 'typesafe-sdk==0.7.0' 'pyarrow>=17,<24'

COPY --from=build /wheels/ /wheels/
RUN pip install --no-deps /wheels/*.whl \
    && ! { pip check || true; } | grep -v 'No broken requirements' | grep -v '^verification-loop ' | grep -q . \
    && python -c 'import delivery_api, interview_engine, spec_generator, verification_loop, langchain_core' \
    && rm -rf /wheels && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin requi \
    && mkdir -p /data/artifacts && chown -R 10001:10001 /data
COPY delivery-api/scripts/docker/full_entry.py delivery-api/scripts/docker/full-smoke.py delivery-api/scripts/docker/preflight.py /app/
ARG REQUI_BUILD_ID=unknown
ENV REQUI_BUILD_ID=$REQUI_BUILD_ID
ARG REQUI_BUILD_REPOS=
ENV REQUI_BUILD_REPOS=$REQUI_BUILD_REPOS
# UTC ISO-8601 image build time, surfaced in the Debug dialog and the everything ZIP.
ARG REQUI_BUILD_AT=
ENV REQUI_BUILD_AT=$REQUI_BUILD_AT
USER 10001:10001
EXPOSE 8000
VOLUME /data
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
 CMD python /app/full_entry.py --healthcheck
CMD ["python", "/app/full_entry.py"]
