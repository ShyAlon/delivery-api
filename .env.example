# Optional Turso embedded replica. Keep the real token only in .env.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-generated-token
# TURSO_SYNC_INTERVAL=60

# Credits = tokens * PRICE_PER_TOKEN + deterministic milliseconds / 10 * PRICE_PER_10MS. Defaults put a full run (~400k tokens) near 5 credits.
PRICE_PER_TOKEN=0.0000125
PRICE_PER_10MS=0.0000005
# Customer USD price per credit, shown next to credits.
USD_PER_CREDIT=1.00

# Shared secret for delivery-api to authenticate to interview-engine.
# Replace the local default for any separately exposed deployment.
INTERVIEW_ENGINE_TOKEN=local-interview-engine-token
