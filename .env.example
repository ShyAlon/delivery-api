# Optional Turso embedded replica. Keep the real token only in .env.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-generated-token
# TURSO_SYNC_INTERVAL=60

# Customer service-unit pricing. Price = tokens * PRICE_PER_TOKEN + deterministic milliseconds / 10 * PRICE_PER_10MS.
PRICE_PER_TOKEN=2
PRICE_PER_10MS=1
